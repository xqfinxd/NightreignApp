<patterns src="LotResultSmallBaseAndSpot.csv" type="map" key="patternId">
    <value>
        <spots type="map" key="smallBaseMapID">
            <value>
                <index type="int" key="mapIndex"/>
                <attachPoint type="_" key="attachId" ref="points"/>
                <attachPoint2 type="_" key="attachId" ref="points2"/>
                <variationId type="_" key="smallBaseMapID" ref="variations"/>
                <variationIndex type="int" key="variationId"/>
                <modifier type="int" key="modifier"/>
            </value>
        </spots>
    </value>
</patterns>
<patterns src="LotResultMapPatternFlag.csv" type="map" key="patternId">
    <value>
        <flag type="list">
            <value>
                <patternSetId type="int" key="patternSetId"/>
                <eventFlag type="int" key="eventFlag"/>
                <modifierSet type="int" key="modifierSet"/>
                <modifier type="int" key="modifier"/>
                <mapType type="$" op="$patternSetId % 10"/>
                <nightlord type="$" op="math.floor(($patternSetId % 100) / 10)"/>
            </value>
        </flag>
    </value>
</patterns>
<points src="WorldMapPointParam.csv" type="map" key="ID">
    <value>
        <gridX type="int" key="gridXNO"/>
        <gridZ type="int" key="gridZNO"/>
        <posX type="float" key="posX"/>
        <posZ type="float" key="posZ"/>
    </value>
</points>
<points2 src="SmallBaseAndSpotAttachPoint.csv" type="map" key="ID">
    <value>
        <gridX type="int" key="gridXNO"/>
        <gridZ type="int" key="gridZNO"/>
        <posX type="float" key="posX"/>
        <posZ type="float" key="posZ"/>
    </value>
</points2>
<variations src="SmallBaseMapVariationParam.csv" type="map" key="ID">
    <value>
        <option index="0" type="int" key="modifier1"/>
        <option index="1" type="int" key="modifier2"/>
        <option index="2" type="int" key="modifier3"/>
        <index index="0" type="int" key="variationValue_0"/>
        <index index="1" type="int" key="variationValue_1"/>
        <index index="2" type="int" key="variationValue_2"/>
        <index index="3" type="int" key="variationValue_3"/>
        <index index="4" type="int" key="variationValue_4"/>
        <index index="5" type="int" key="variationValue_5"/>
        <index index="6" type="int" key="variationValue_6"/>
        <index index="7" type="int" key="variationValue_7"/>
        <index index="8" type="int" key="variationValue_8"/>
        <index index="9" type="int" key="variationValue_9"/>
        <index index="10" type="int" key="variationValue_10"/>
    </value>
</variations>